# Zusaetzliche Variablen fuer den HaRP-Deploy-Daemon der Testumgebung.
# Den Schluessel z. B. mit `openssl rand -hex 32` erzeugen.
APPAPI_HARP_SHARED_KEY=CHANGE_ME_STRONG_RANDOM_SECRET

# Optional: Subnetz des Docker-Netzes von Nginx Proxy Manager.
# Ermitteln mit:
# docker network inspect proxy_net --format '{{(index .IPAM.Config 0).Subnet}}'
APPAPI_HARP_TRUSTED_PROXY_IPS=
